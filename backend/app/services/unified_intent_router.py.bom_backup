"""Feature-flagged agricultural intent routing fallback."""

def route_unified_answer(user_texts):
    if not user_texts:
        return None

    q = user_texts[-1].strip().lower()
    if not q:
        return None

    def has(*terms):
        return any(term in q for term in terms)

    rice = has("ধান", "বোরো", "আমন", "আউশ", "rice", "paddy")
    fish = has("মাছ", "পুকুর", "mach", "maach", "pukur", "fish")

    # Weather and rainfall
    if has("বৃষ্টি", "আবহাওয়া", "weather", "rain") and has(
        "ধান", "ফসল", "জমি", "rice", "crop"
    ):
        return (
            "### বৃষ্টি ও ফসল ব্যবস্থাপনা\n\n"
            "আগামীকালের নিশ্চিত আবহাওয়ার তথ্য এখানে নেই। "
            "বৃষ্টি হলে জমিতে পানি জমছে কি না দেখুন। "
            "প্রয়োজনে পানি নিষ্কাশনের ব্যবস্থা রাখুন। "
            "বৃষ্টির ঠিক আগে সার বা কীটনাশক প্রয়োগের সিদ্ধান্ত "
            "নেবেন না। আপনার জেলা, ফসলের বয়স ও জমির অবস্থা জানান।",
            "unified_weather",
        )

    # Bangla and Banglish fish emergencies
    if fish and has(
        "মারা", "মরছে", "মরেছে", "dying", "dead",
        "more jacche", "mara jacche"
    ):
        return (
            "### পুকুরে মাছ মারা যাচ্ছে\n\n"
            "এটি জরুরি সমস্যা হতে পারে। সম্ভব হলে পানিতে "
            "অক্সিজেন বাড়ানোর ব্যবস্থা করুন এবং অতিরিক্ত খাবার "
            "সাময়িকভাবে বন্ধ রাখুন। পানির অক্সিজেন, pH ও "
            "তাপমাত্রা পরীক্ষা করুন। কারণ নিশ্চিত না হয়ে "
            "ওষুধ ব্যবহার করবেন না। মাছের প্রজাতি, কত মাছ "
            "মরছে এবং পানির বর্তমান অবস্থা জানান।",
            "unified_fish_emergency",
        )

    if fish and has(
        "খাচ্ছে না", "খায় না", "খাবার খাচ্ছে না",
        "khacche na", "khay na", "not eating"
    ):
        return (
            "### মাছ খাবার খাচ্ছে না\n\n"
            "পানির অক্সিজেন, তাপমাত্রা ও পানির গুণমান পরীক্ষা করুন। "
            "মাছের আচরণ ও খাবারের অবস্থা পর্যবেক্ষণ করুন। "
            "অতিরিক্ত খাবার দেবেন না। মাছের প্রজাতি, পুকুরের "
            "আয়তন এবং কত দিন ধরে খাবার খাচ্ছে না তা জানান। "
            "মাছ অসুস্থ হলে স্থানীয় মৎস্য কর্মকর্তার পরামর্শ নিন।",
            "unified_fish_feeding",
        )

    # Poultry
    if has("হাঁস", "duck") and has(
        "অসুস্থ", "রোগ", "মারা", "sick", "ill"
    ):
        return (
            "### হাঁসের স্বাস্থ্য পরামর্শ\n\n"
            "অসুস্থ হাঁসকে সম্ভব হলে অন্য হাঁস থেকে আলাদা রাখুন। "
            "পরিষ্কার পানি ও নিরাপদ খাবার দিন। "
            "হাঁসের বয়স, লক্ষণ, আক্রান্ত হাঁসের সংখ্যা "
            "ও অসুস্থতার সময়কাল জানান। "
            "শ্বাসকষ্ট বা একাধিক হাঁসের মৃত্যু হলে দ্রুত "
            "প্রাণিসম্পদ কর্মকর্তার সাহায্য নিন। "
            "রোগ নিশ্চিত না করে ওষুধ দেবেন না।",
            "unified_duck_health",
        )

    # Rice blast
    if rice and has("blast", "ব্লাস্ট"):
        return (
            "### Rice Blast Disease\n\n"
            "Rice blast can cause characteristic lesions on leaves "
            "and damage other plant parts. Confirm the symptoms "
            "before choosing treatment. Review field conditions, "
            "avoid unnecessary nitrogen application, and seek "
            "locally approved disease-management guidance. "
            "Share the rice growth stage, location and a clear "
            "photo for more specific advice.",
            "unified_rice_blast",
        )

    # Seasonal rice care
    months = (
        "জানুয়ারি", "জানুয়ারি", "ফেব্রুয়ারি",
        "মার্চ", "এপ্রিল", "মে", "জুন",
        "জুলাই", "আগস্ট", "সেপ্টেম্বর",
        "অক্টোবর", "নভেম্বর", "ডিসেম্বর",
    )

    if rice and any(m in q for m in months) and has(
        "যত্ন", "কাজ", "চাষ", "করব", "করতে", "পরিচর্যা"
    ):
        if has("জানুয়ারি", "জানুয়ারি"):
            advice = (
                "বোরো ধানের ক্ষেত্রে চারার অবস্থা, "
                "শীতের প্রভাব এবং জমির পানি পর্যবেক্ষণ করুন। "
                "রোপণ ও সার প্রয়োগের সিদ্ধান্ত স্থানীয় "
                "মৌসুম ও জমির অবস্থার ওপর নির্ভর করবে।"
            )
        elif "মে" in q:
            advice = (
                "বোরো ধান পরিপক্ব হলে কাটার উপযুক্ত অবস্থা "
                "যাচাই করুন। কাটার পর ধান নিরাপদভাবে শুকানো "
                "ও সংরক্ষণ গুরুত্বপূর্ণ। আউশ চাষের পরিকল্পনাও "
                "এলাকার মৌসুম অনুযায়ী করা যায়।"
            )
        else:
            advice = (
                "ধানের পরিচর্যা নির্ভর করে আউশ, আমন বা "
                "বোরো মৌসুম, গাছের বয়স, এলাকার আবহাওয়া "
                "ও জমির অবস্থার ওপর।"
            )

        return (
            "### মাসভিত্তিক ধান পরিচর্যা\n\n"
            + advice
            + "\n\nআপনার জেলা, ধানের ধরন ও বর্তমান "
            "বৃদ্ধির পর্যায় জানালে আরও নির্দিষ্ট "
            "পরামর্শ দেওয়া যাবে।",
            "unified_rice_season",
        )

    # Fertilizer
    if has("সার", "ইউরিয়া", "ইউরিয়া", "fertilizer") and rice:
        return (
            "### ধানের সার ব্যবস্থাপনা\n\n"
            "ইউরিয়ার সঠিক পরিমাণ জমির আয়তন, মাটির "
            "উর্বরতা, ধানের জাত ও বৃদ্ধির পর্যায়ের ওপর "
            "নির্ভর করে। মাটি পরীক্ষার ফল ছাড়া নির্দিষ্ট "
            "পরিমাণ অনুমান করা নিরাপদ নয়। "
            "জমির আয়তন, ধানের বয়স ও আগে দেওয়া "
            "সারের পরিমাণ জানান।",
            "unified_rice_fertilizer",
        )

    # Irrigation
    if has("সেচ", "irrigation") and rice:
        return (
            "### ধানের সেচ ব্যবস্থাপনা\n\n"
            "জমির মাটি, ধানের বৃদ্ধির পর্যায়, "
            "বৃষ্টিপাত এবং পানির উপস্থিতি দেখে "
            "সেচের সিদ্ধান্ত নিন। জমিতে অতিরিক্ত "
            "পানি জমে থাকলে নিষ্কাশন প্রয়োজন হতে পারে। "
            "আপনার জেলা, ধানের বয়স ও জমির "
            "বর্তমান পানির অবস্থা জানান।",
            "unified_rice_irrigation",
        )

    # Market prices without verified live data
    crops = (
        "আলু", "টমেটো", "পেঁয়াজ", "পেঁয়াজ",
        "পাট", "গম", "মরিচ", "potato", "tomato"
    )

    if has("দাম", "বাজারদর", "মূল্য", "price") and any(
        crop in q for crop in crops
    ):
        return (
            "### কৃষিপণ্যের বাজারদর\n\n"
            "এই মুহূর্তে যাচাই করা হালনাগাদ স্থানীয় "
            "বাজারদর পাওয়া যায়নি। তাই কোনো মূল্য "
            "অনুমান করে জানাচ্ছি না। "
            "আপনার জেলা, বাজারের নাম এবং "
            "কেজি না মণ হিসেবে দাম জানতে চান তা জানান। "
            "সর্বশেষ মূল্য স্থানীয় বাজার বা "
            "নির্ভরযোগ্য সরকারি উৎস থেকে যাচাই করা প্রয়োজন।",
            "unified_market_price",
        )

    # Soil fertility
    if has("মাটি", "মাটির", "soil") and has(
        "উর্বরতা", "fertility", "স্বাস্থ্য", "nutrient"
    ):
        return (
            "### মাটির উর্বরতা উন্নয়ন\n\n"
            "মাটি পরীক্ষা করে পুষ্টির ঘাটতি শনাক্ত করুন। "
            "পরিপক্ব জৈব সার, ফসলের অবশিষ্টাংশের "
            "সঠিক ব্যবস্থাপনা এবং উপযুক্ত ফসল পর্যায়ক্রম "
            "ব্যবহার মাটির স্বাস্থ্য উন্নত করতে সাহায্য করে। "
            "মাটি পরীক্ষার ফল অনুযায়ী সুষম সার ব্যবহার করুন। "
            "আপনার মাটির ধরন ও ফসলের নাম জানান।",
            "unified_soil_health",
        )

    return None
