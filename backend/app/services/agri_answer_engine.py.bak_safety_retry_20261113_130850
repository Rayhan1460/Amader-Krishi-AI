def _detect_crop(text):
    text = text.lower()
    rice = any(x in text for x in (
        "\u09a7\u09be\u09a8", "rice", "paddy"
    ))
    tomato = any(x in text for x in (
        "\u099f\u09ae\u09c7\u099f\u09cb", "tomato"
    ))
    if rice and tomato:
        return "both"
    if rice:
        return "rice"
    if tomato:
        return "tomato"
    return None


def draft_agricultural_answer(messages, category):
    """Create limited crop-health guidance from one session's user turns.

    Returns None when outside the supported scope.
    Does not call an ML model, Gemini, network, or database.
    """
    if category != "plant_disease_pest":
        return None

    if not isinstance(messages, (list, tuple)):
        return None

    turns = [
        item["content"].strip()
        for item in messages
        if isinstance(item, dict)
        and item.get("role") == "user"
        and isinstance(item.get("content"), str)
        and item["content"].strip()
    ]

    if not turns:
        return None

    latest = turns[-1].lower()
    symptom_terms = (
        "\u09aa\u09be\u09a4\u09be",
        "\u09a6\u09be\u0997",
        "\u09b0\u09cb\u0997",
        "\u09aa\u09cb\u0995\u09be",
        "leaf", "spot", "blight", "disease", "pest",
    )

    current_symptom = any(x in latest for x in symptom_terms)
    previous = turns[-2].lower() if len(turns) > 1 else ""
    previous_symptom = any(x in previous for x in symptom_terms)

    # Only support a short follow-up if the prior user turn was
    # clearly about a crop-health symptom.
    followup = (
        bool(previous_symptom)
        and len(latest) <= 80
        and not current_symptom
    )

    if not current_symptom and not followup:
        return None

    crop = _detect_crop(latest)

    if crop is None and followup:
        crop = _detect_crop(previous)

    if crop == "rice":
        return RICE_REPLY
    if crop == "tomato":
        return TOMATO_REPLY
    if crop == "both":
        return BOTH_REPLY

    return UNKNOWN_REPLY
