import threading

# Flag to enable real inference – keep False until explicitly approved.
_ENABLE_REAL_INFERENCE: bool = False

# Cached heavy objects (initialized lazily and thread‑safe)
_encoder = None  # type: ignore
_classifier = None  # type: ignore
_load_lock = threading.Lock()

def _initialize_model() -> bool:
    """Load the encoder and classifier from the extracted model directory.

    Returns ``True`` if both objects were successfully loaded, ``False`` otherwise.
    Heavy libraries are imported only inside this function to avoid side‑effects at import time.
    """
    global _encoder, _classifier
    # If already loaded, nothing to do
    if _encoder is not None and _classifier is not None:
        return True
    with _load_lock:
        # Double‑check after acquiring the lock
        if _encoder is not None and _classifier is not None:
            return True
        # Resolve model root
        model_root = Path(__file__).resolve().parents[3] / "model_assets" / "intent_classifier" / "AgriSphere_Trained_Intent_Model"
        required = [
            model_root / "manifest.json",
            model_root / "agriculture_intent_router.joblib",
            model_root / "encoder" / "config.json",
            model_root / "encoder" / "model.safetensors",
            model_root / "encoder" / "tokenizer.json",
        ]
        if not all(p.is_file() for p in required):
            return False
        try:
            # Import heavy dependencies only when needed
            import numpy as np  # noqa: F401
            import joblib
            from sentence_transformers import SentenceTransformer
            # Load encoder – the SentenceTransformer constructor will read the config folder.
            _encoder = SentenceTransformer(str(model_root / "encoder"))
            # Load the joblib classifier
            _classifier = joblib.load(str(model_root / "agriculture_intent_router.joblib"))
            return True
        except Exception:
            # Any import or load failure results in a safe false return.
            _encoder = None
            _classifier = None
            return False

# ---------------------------------------------------------------------
# Public API – updated to optionally perform real inference
# ---------------------------------------------------------------------
def classify(question: str) -> Tuple[Dict[str, Any], str]:
    """Validate *question* and optionally perform real inference.

    When ``_ENABLE_REAL_INFERENCE`` is ``False`` (default) the function behaves exactly as before –
    it checks the manifest and returns a stub payload with ``predicted_category`` and ``confidence`` set to ``None``.
    When the flag is ``True`` and the heavy model can be loaded, the function runs the full preprocessing
    (adds the ``"query: "`` prefix, normalises embeddings) and returns the actual prediction.
    """
    if not isinstance(question, str) or not question.strip():
        return {}, "invalid_input"
    # Ensure manifest is available – this also validates the label list.
    _, manifest_status = _load_manifest()
    if manifest_status != "ok":
        return {}, manifest_status
    # Stub mode – no heavy work.
    if not _ENABLE_REAL_INFERENCE:
        payload = {"predicted_category": None, "confidence": None}
        return payload, "ok"
    # Real inference path.
    if not _initialize_model():
        # Model assets missing or load failed.
        return {}, "model_missing"
    # Preprocess according to original ``predict.py`` – prepend "query: " and strip.
    query = f"query: {question.strip()}"
    # Encode – ``normalize_embeddings=True`` mirrors the original script.
    embedding = _encoder.encode(query, normalize_embeddings=True)
    # Classifier prediction – we use predict_proba to obtain confidences.
    try:
        probs = _classifier.predict_proba([embedding])[0]
        # Determine the index with highest probability.
        best_idx = int(probs.argmax())
        # Resolve label using cached list.
        label = _resolve_label(best_idx)
        confidence = float(probs.max())
        payload = {"predicted_category": label, "confidence": confidence}
        return payload, "ok"
    except Exception:
        # Any inference error is treated as a generic failure.
        return {}, "inference_error"

# The module deliberately does not import heavy libraries (torch,
# sentence‑transformers, joblib) at import time.  They can be imported
# inside a separate ``initialize_model()`` function when real inference
# is required.

__all__ = [
    "classify",
    "_resolve_label",
    "_load_manifest",
]
