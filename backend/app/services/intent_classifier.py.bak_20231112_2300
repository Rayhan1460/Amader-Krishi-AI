"""Intent classifier service (lazy, no heavy imports).

- Resolves project root via ``Path(__file__).resolve().parents[3]``.
- Locates the portable model ZIP (first file whose name starts with
  ``AgriSphere_Trained_Intent_Model_PORTABLE``) in the project root.
- Reads ``manifest.json`` inside the ZIP to obtain the ordered list of
  ``labels`` (13 categories).
- Provides :func:`classify` which validates input and returns a structured
  result without actually loading the encoder or the job‑lib classifier.
- Caches the manifest and label list after the first successful read.
- Includes a helper ``_resolve_label`` that can turn an integer, a NumPy
  integer or a string label into the canonical string label.
- All heavy model loading is deferred to later implementation; if the
  ZIP is missing or the manifest cannot be read the function returns a
  ``status`` of ``"model_missing"`` or ``"manifest_error"``.
"""

from __future__ import annotations


from pathlib import Path
from typing import Any, Dict, Tuple, Union

# ---------------------------------------------------------------------
# No top-level imports to avoid side effects during reload
import json

import zipfile
# ---------------------------------------------------------------------
_manifest_cache: dict | None = None
_labels_cache: list[str] | None = None
_model_zip_path: Path | None = None

# ---------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------
def _find_model_zip() -> Path | None:
    """Search the project root for the portable intent‑model ZIP.

    Returns ``None`` if no matching file is found.
    """
    project_root = Path(__file__).resolve().parents[3]
    candidates = list(project_root.glob('AgriSphere_Trained_Intent_Model_PORTABLE*.zip'))
    return candidates[0] if candidates else None

def _load_manifest() -> Tuple[dict | None, str]:
    """Read ``manifest.json`` from the ZIP.

    Returns a tuple ``(manifest_dict, status)`` where ``status`` is ``"ok"``
    on success or an error code string.
    """
    global _manifest_cache, _labels_cache, _model_zip_path
    # Always locate the zip anew to avoid stale cache
    _model_zip_path = _find_model_zip()
    # If zip missing, clear caches and report
    if _model_zip_path is None or not _model_zip_path.is_file():
        _manifest_cache = None
        _labels_cache = None
        return None, "model_missing"
    # If we have cached manifest, return it
    if _manifest_cache is not None:
        return _manifest_cache, "ok"
    # Load manifest from zip
    try:
        with zipfile.ZipFile(_model_zip_path, 'r') as z:
            with z.open('AgriSphere_Trained_Intent_Model/manifest.json') as f:
                manifest = json.load(f)
                _manifest_cache = manifest
                labels = manifest.get('labels')
                if not isinstance(labels, list) or len(labels) != 13:
                    _manifest_cache = None
                    return None, "invalid_labels"
                _labels_cache = labels
                return manifest, "ok"
    except Exception as exc:  # pragma: no cover – defensive
        _manifest_cache = None
        return None, f"manifest_error: {exc}"

def _resolve_label(raw_label: Any) -> str | None:
    """Convert a raw classifier output to the canonical string label.

    ``raw_label`` may be:
    - an ``int`` index into the ``_labels_cache`` list,
    - a NumPy integer (sub‑class of ``int``),
    - a string that already matches a known label.
    Returns ``None`` if the value cannot be resolved.
    """
    if _labels_cache is None:
        # Manifest not loaded – cannot resolve
        return None
    # Integer or NumPy integer
    if isinstance(raw_label, (int,)):
        if 0 <= raw_label < len(_labels_cache):
            return _labels_cache[raw_label]
        return None
    # String label – case‑sensitive match against known list
    if isinstance(raw_label, str):
        return raw_label if raw_label in _labels_cache else None
    return None

# ---------------------------------------------------------------------
# Lazy model initialization (real inference)
# ---------------------------------------------------------------------
import threading

# Flag to enable real inference – keep False until explicitly approved.
_ENABLE_REAL_INFERENCE: bool = False

# Cached heavy objects (initialized lazily and thread‑safe)
_encoder = None  # type: ignore
_classifier = None  # type: ignore
_load_lock = threading.Lock()

def _initialize_model() -> bool:
    """Load the encoder and classifier from the extracted model directory.

    Returns ``True`` if both objects were successfully loaded, ``False`` otherwise.
    Heavy libraries are imported only inside this function to avoid side‑effects at import time.
    """
    global _encoder, _classifier
    # If already loaded, nothing to do
    if _encoder is not None and _classifier is not None:
        return True
    with _load_lock:
        # Double‑check after acquiring the lock
        if _encoder is not None and _classifier is not None:
            return True
        # Resolve model root
        model_root = Path(__file__).resolve().parents[3] / "model_assets" / "intent_classifier" / "AgriSphere_Trained_Intent_Model"
        required = [
            model_root / "manifest.json",
            model_root / "agriculture_intent_router.joblib",
            model_root / "encoder" / "config.json",
            model_root / "encoder" / "model.safetensors",
            model_root / "encoder" / "tokenizer.json",
        ]
        if not all(p.is_file() for p in required):
            return False
        try:
            # Import heavy dependencies only when needed
            import numpy as np  # noqa: F401
            import joblib
            from sentence_transformers import SentenceTransformer
            # Load encoder – the SentenceTransformer constructor will read the config folder.
            _encoder = SentenceTransformer(str(model_root / "encoder"))
            # Load the joblib classifier
            _classifier = joblib.load(str(model_root / "agriculture_intent_router.joblib"))
            return True
        except Exception:
            # Any import or load failure results in a safe false return.
            _encoder = None
            _classifier = None
            return False

# ---------------------------------------------------------------------
# Public API – updated to optionally perform real inference
# ---------------------------------------------------------------------
def classify(question: str) -> Tuple[Dict[str, Any], str]:
    """Validate *question* and optionally perform real inference.

    When ``_ENABLE_REAL_INFERENCE`` is ``False`` (default) the function behaves exactly as before –
    it checks the manifest and returns a stub payload with ``predicted_category`` and ``confidence`` set to ``None``.
    When the flag is ``True`` and the heavy model can be loaded, the function runs the full preprocessing
    (adds the ``"query: "`` prefix, normalises embeddings) and returns the actual prediction.
    """
    if not isinstance(question, str) or not question.strip():
        return {}, "invalid_input"
    # Ensure manifest is available – this also validates the label list.
    _, manifest_status = _load_manifest()
    if manifest_status != "ok":
        return {}, manifest_status
    # Stub mode – no heavy work.
    if not _ENABLE_REAL_INFERENCE:
        payload = {"predicted_category": None, "confidence": None}
        return payload, "ok"
    # Real inference path.
    if not _initialize_model():
        # Model assets missing or load failed.
        return {}, "model_missing"
    # Preprocess according to original ``predict.py`` – prepend "query: " and strip.
    query = f"query: {question.strip()}"
    # Encode – ``normalize_embeddings=True`` mirrors the original script.
    embedding = _encoder.encode(query, normalize_embeddings=True)
    # Classifier prediction – we use predict_proba to obtain confidences.
    try:
        probs = _classifier.predict_proba([embedding])[0]
        # Determine the index with highest probability.
        best_idx = int(probs.argmax())
        # Resolve label using cached list.
        label = _resolve_label(best_idx)
        confidence = float(probs.max())
        payload = {"predicted_category": label, "confidence": confidence}
        return payload, "ok"
    except Exception:
        # Any inference error is treated as a generic failure.
        return {}, "inference_error"

# The module deliberately does not import heavy libraries (torch,
# sentence‑transformers, joblib) at import time.  They can be imported
# inside a separate ``initialize_model()`` function when real inference
# is required.

__all__ = [
    "classify",
    "_resolve_label",
    "_load_manifest",
]

