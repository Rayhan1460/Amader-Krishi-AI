import { useState, type FormEvent } from 'react';
import { Link, useNavigate, useLocation } from 'react-router-dom';
import { Lock, User, Eye, EyeOff, AlertCircle, ArrowRight, Sparkles } from 'lucide-react';
import { useAuth } from '../context/AuthContext.tsx';
import { getErrorMessage } from '../services/api.ts';
import { Button } from '../components/common/Button.tsx';
import { Input } from '../components/common/Input.tsx';
import { BrandLogo } from '../components/common/BrandLogo.tsx';

export function LoginPage() {
  const [username, setUsername] = useState('');
  const [password, setPassword] = useState('');
  const [showPassword, setShowPassword] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [isSubmitting, setIsSubmitting] = useState(false);

  const { login } = useAuth();
  const navigate = useNavigate();
  const location = useLocation();

  const from = (location.state as { from?: { pathname: string } })?.from?.pathname || '/workspace';

  const handleSubmit = async (e: FormEvent) => {
    e.preventDefault();
    setError(null);

    if (!username.trim()) {
      setError('ইউজারনেম পূরণ আবশ্যক (Username is required).');
      return;
    }
    if (password.length < 6) {
      setError('পাসওয়ার্ড ন্যূনতম ৬ অক্ষরের হতে হবে (Minimum 6 characters).');
      return;
    }

    setIsSubmitting(true);
    try {
      await login(username.trim(), password);
      navigate(from, { replace: true });
    } catch (err) {
      setError(getErrorMessage(err));
    } finally {
      setIsSubmitting(false);
    }
  };

  return (
    <div className="min-h-screen bg-subtle-mesh flex flex-col justify-center py-12 sm:px-6 lg:px-8">
      {/* Top Branding Link */}
      <div className="sm:mx-auto sm:w-full sm:max-w-md text-center mb-6">
        <Link to="/" className="inline-block hover:opacity-90 transition-opacity">
          <BrandLogo size="lg" variant="dark" withTagline={false} />
        </Link>
        <h2 className="mt-4 font-bengali font-bold text-2xl sm:text-3xl text-forest-950 tracking-tight">
          ওয়ার্কস্পেসে লগইন করুন
        </h2>
        <p className="mt-1 text-xs sm:text-sm text-sage-700 font-bengali">
          আপনার এআই মডেল, প্রেডিকশন অডিট এবং কৃষি গবেষণায় প্রবেশ করুন
        </p>
      </div>

      {/* Main Form Card */}
      <div className="sm:mx-auto sm:w-full sm:max-w-md px-4 sm:px-0">
        <div className="glass-card rounded-3xl p-8 sm:p-10 shadow-xl border border-white/80 bg-white/90 backdrop-blur-xl">
          
          {/* New account banner */}
          <div className="mb-6 bg-forest-50 border border-forest-200/80 rounded-2xl p-3 flex items-center justify-between">
            <div className="flex items-center gap-2 text-xs text-forest-900 font-bengali">
              <Sparkles className="w-4 h-4 text-forest-600 shrink-0" />
              <span>আমাদের কৃষি AI-তে নতুন?</span>
            </div>
            <Link
              to="/register"
              className="text-xs font-semibold font-bengali text-forest-700 hover:text-forest-900 bg-white px-2.5 py-1 rounded-lg border border-forest-300 shadow-2xs hover:bg-forest-50 transition-colors"
            >
              নতুন একাউন্ট খুলুন
            </Link>
          </div>

          {/* Future SSO / Demo Options (Disabled / Coming Soon) */}
          <div className="space-y-2 mb-6">
            <button
              type="button"
              disabled
              className="w-full flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl border border-sage-200 bg-sage-50/60 text-xs font-medium text-sage-500 cursor-not-allowed font-bengali transition-colors"
              title="Google সাইন-ইন শীঘ্রই আসছে"
            >
              <svg className="w-4 h-4 opacity-60" viewBox="0 0 24 24">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
              </svg>
              <span>Google দিয়ে প্রবেশ</span>
              <span className="ml-1 text-[10px] bg-sage-200/80 text-sage-600 px-1.5 py-0.5 rounded font-mono">
                শীঘ্রই আসছে
              </span>
            </button>
          </div>

          <div className="relative my-6">
            <div className="absolute inset-0 flex items-center">
              <div className="w-full border-t border-sage-200" />
            </div>
            <div className="relative flex justify-center text-xs">
              <span className="bg-white px-3 text-sage-500 font-bengali">অথবা ইউজারনেম দিয়ে লগইন</span>
            </div>
          </div>

          {/* Error Banner */}
          {error && (
            <div className="mb-6 p-4 rounded-xl bg-red-50 border border-red-200 flex items-start gap-3 text-xs text-red-800">
              <AlertCircle className="w-4 h-4 text-red-600 shrink-0 mt-0.5" />
              <div className="flex-1 font-bengali">
                <p className="font-semibold">লগইন ব্যর্থ হয়েছে (Authentication Failed)</p>
                <p className="mt-0.5">{error}</p>
              </div>
            </div>
          )}

          <form onSubmit={handleSubmit} className="space-y-5">
            {/* Username Input */}
            <Input
              label="ইউজারনেম (Username)"
              type="text"
              id="username"
              value={username}
              onChange={(e) => setUsername(e.target.value)}
              placeholder="e.g. farmer_user বা agronomist"
              required
              autoComplete="username"
              leftIcon={<User className="w-4 h-4" />}
            />

            {/* Password Input */}
            <Input
              label="পাসওয়ার্ড (Password)"
              type={showPassword ? 'text' : 'password'}
              id="password"
              value={password}
              onChange={(e) => setPassword(e.target.value)}
              placeholder="••••••••"
              required
              autoComplete="current-password"
              leftIcon={<Lock className="w-4 h-4" />}
              rightIcon={
                <button
                  type="button"
                  onClick={() => setShowPassword(!showPassword)}
                  className="cursor-pointer hover:text-charcoal-900 transition-colors"
                  aria-label={showPassword ? 'Hide password' : 'Show password'}
                >
                  {showPassword ? <EyeOff className="w-4 h-4" /> : <Eye className="w-4 h-4" />}
                </button>
              }
            />

            {/* Submit Button */}
            <Button
              type="submit"
              variant="primary"
              size="lg"
              className="w-full font-bengali font-semibold shadow-md shadow-forest-900/20"
              isLoading={isSubmitting}
              rightIcon={<ArrowRight className="w-4 h-4" />}
            >
              লগইন করুন (Sign In)
            </Button>
          </form>

          {/* Switch to Registration */}
          <div className="mt-8 pt-6 border-t border-sage-200 text-center">
            <p className="text-xs text-charcoal-700 font-bengali">
              একাউন্ট নেই?{' '}
              <Link
                to="/register"
                className="font-semibold text-forest-700 hover:text-forest-900 underline underline-offset-2"
              >
                নতুন একাউন্ট খুলুন
              </Link>
            </p>
          </div>

        </div>

        {/* Security Note */}
        <p className="mt-6 text-center text-[11px] text-sage-600 font-bengali">
          Argon2 পাসওয়ার্ড হ্যাশিং ও স্টেটলেস JWT সেশন দ্বারা সুরক্ষিত।
        </p>
      </div>
    </div>
  );
}