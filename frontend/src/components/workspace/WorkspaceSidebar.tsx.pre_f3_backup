import { MessageSquare, Wrench, History, Cpu, LogOut, UserCheck, Sparkles } from 'lucide-react';
import { useAuth } from '../../context/AuthContext.tsx';
import { BrandLogo } from '../common/BrandLogo.tsx';

export type WorkspaceTab = 'chat' | 'tools' | 'history' | 'overview';

interface WorkspaceSidebarProps {
  activeTab: WorkspaceTab;
  onSelectTab: (tab: WorkspaceTab) => void;
  historyCount?: number;
}

export function WorkspaceSidebar({ activeTab, onSelectTab, historyCount }: WorkspaceSidebarProps) {
  const { user, isDemo, logout } = useAuth();

  const navItems = [
    {
      id: 'chat' as WorkspaceTab,
      label: 'AI সহকারী (Chat)',
      description: 'কথোপকথন ও পরামর্শ',
      icon: MessageSquare,
      badge: 'Live',
    },
    {
      id: 'tools' as WorkspaceTab,
      label: '৭টি এআই মডেল কনসোল',
      description: 'সরাসরি মডেল ইনফারেন্স',
      icon: Wrench,
      badge: '৭টি মডেল',
    },
    {
      id: 'history' as WorkspaceTab,
      label: 'প্রেডিকশন ইতিহাস',
      description: 'অডিটেবল রেকর্ডস',
      icon: History,
      badge: historyCount !== undefined ? `${historyCount}` : undefined,
    },
    {
      id: 'overview' as WorkspaceTab,
      label: 'মডেল রেজিস্ট্রি ও অডিট',
      description: 'আর্কিটেকচার ও মেট্রিক্স',
      icon: Cpu,
      badge: '৭/৭ সক্রিয়',
    },
  ];

  return (
    <aside className="w-full lg:w-64 bg-white rounded-3xl border border-sage-200 p-4 shadow-xs flex flex-col justify-between shrink-0">
      <div>
        {/* Brand */}
        <div className="px-2 py-2 mb-6 border-b border-sage-100 pb-4">
          <BrandLogo size="md" variant="dark" withTagline={false} />
          <span className="text-[10px] font-bengali font-semibold text-forest-700 bg-forest-50 px-2 py-0.5 rounded-md inline-block mt-2">
            গবেষণা ও সিদ্ধান্ত ওয়ার্কস্পেস
          </span>
        </div>

        {/* Navigation Items */}
        <nav className="space-y-1.5">
          {navItems.map((item) => {
            const Icon = item.icon;
            const isActive = activeTab === item.id;
            return (
              <button
                key={item.id}
                type="button"
                onClick={() => onSelectTab(item.id)}
                className={`w-full flex items-center justify-between px-3.5 py-2.5 rounded-2xl text-xs font-semibold font-bengali transition-all cursor-pointer ${
                  isActive
                    ? 'bg-forest-800 text-white shadow-xs shadow-forest-900/20'
                    : 'text-charcoal-700 hover:bg-sage-100 hover:text-forest-950'
                }`}
              >
                <div className="flex items-center gap-2.5">
                  <Icon className={`w-4 h-4 ${isActive ? 'text-emerald-400' : 'text-sage-600'}`} />
                  <div className="text-left">
                    <span className="block">{item.label}</span>
                    <span
                      className={`text-[10px] font-normal block ${
                        isActive ? 'text-forest-200' : 'text-sage-500'
                      }`}
                    >
                      {item.description}
                    </span>
                  </div>
                </div>

                {item.badge && (
                  <span
                    className={`text-[10px] font-mono px-2 py-0.5 rounded-md ${
                      isActive ? 'bg-forest-900 text-emerald-300' : 'bg-sage-200 text-sage-800'
                    }`}
                  >
                    {item.badge}
                  </span>
                )}
              </button>
            );
          })}
        </nav>
      </div>

      {/* User Card & Logout */}
      <div className="pt-4 mt-6 border-t border-sage-200">
        <div className={`rounded-2xl p-3 border mb-3 flex items-center justify-between ${
          isDemo ? 'bg-amber-50/80 border-amber-200' : 'bg-cream-50 border-sage-200'
        }`}>
          <div className="flex items-center gap-2 overflow-hidden">
            <div className={`w-8 h-8 rounded-full flex items-center justify-center shrink-0 ${
              isDemo ? 'bg-amber-200 text-amber-900' : 'bg-forest-100 text-forest-800'
            }`}>
              {isDemo ? <Sparkles className="w-4 h-4 text-amber-800" /> : <UserCheck className="w-4 h-4" />}
            </div>
            <div className="overflow-hidden">
              <p className="text-xs font-bold text-charcoal-900 truncate">{user?.username}</p>
              <p className={`text-[10px] font-medium flex items-center gap-1 font-bengali ${
                isDemo ? 'text-amber-800' : 'text-emerald-700'
              }`}>
                <span className={`w-1.5 h-1.5 rounded-full ${isDemo ? 'bg-amber-500' : 'bg-emerald-500'}`} />
                {isDemo ? 'গেস্ট ডেমো সেশন' : 'সক্রিয় সেশন'}
              </p>
            </div>
          </div>
        </div>

        <button
          type="button"
          onClick={logout}
          className="w-full flex items-center justify-center gap-2 px-3 py-2 rounded-xl text-xs font-semibold text-charcoal-700 hover:bg-red-50 hover:text-red-700 transition-colors cursor-pointer font-bengali"
        >
          <LogOut className="w-3.5 h-3.5" />
          <span>{isDemo ? 'ডেমো ত্যাগ করুন' : 'লগআউট (Sign Out)'}</span>
        </button>
      </div>
    </aside>
  );
}